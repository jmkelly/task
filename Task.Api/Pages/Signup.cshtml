@page
@using Task.Api.Pages
@model SignupModel
@{
    ViewData["Title"] = "Create account";
}

<section class="page-toolbar" aria-label="Create account">
    <div class="page-toolbar-copy">
        <p class="page-eyebrow">Task workspace</p>
        <h1 class="page-title">Create account</h1>
        <p class="page-subtitle">The first account on a new server becomes the administrator.</p>
    </div>
</section>

<section class="board-surface" style="max-width: 420px; margin: 2rem auto; padding: 2rem;">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p style="color: var(--danger, #e5484d); margin-bottom: 1rem;">@Model.ErrorMessage</p>
    }

    <form method="post" class="form-group">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label for="username">Username</label>
            <input class="search-input" id="username" name="Username" type="text" required minlength="3" maxlength="32" autocomplete="username" style="width: 100%;" />
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input class="search-input" id="password" name="Password" type="password" required minlength="8" autocomplete="new-password" style="width: 100%;" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">Create account</button>
            <a class="btn-quiet" href="/login">Sign in instead</a>
        </div>
    </form>
</section>
