@page
@using Task.Api.Pages
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="page-toolbar" aria-label="Sign in">
    <div class="page-toolbar-copy">
        <p class="page-eyebrow">Task workspace</p>
        <h1 class="page-title">Sign in</h1>
        <p class="page-subtitle">Sign in to access your task board.</p>
    </div>
</section>

<section class="board-surface" style="max-width: 420px; margin: 2rem auto; padding: 2rem;">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p style="color: var(--danger, #e5484d); margin-bottom: 1rem;">@Model.ErrorMessage</p>
    }

    <form method="post" class="form-group">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label for="username">Username</label>
            <input class="search-input" id="username" name="Username" type="text" required autofocus autocomplete="username" style="width: 100%;" />
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input class="search-input" id="password" name="Password" type="password" required autocomplete="current-password" style="width: 100%;" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">Sign in</button>
            <a class="btn-quiet" href="/signup">Create an account</a>
        </div>
    </form>
</section>
