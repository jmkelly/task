<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Task Kanban Board</title>
    <script src="https://unpkg.com/htmx.org@2.0.8"></script>
    <script src="https://unpkg.com/htmx.org@2.0.8/dist/ext/ws.js"></script>
    <script>
        document.addEventListener('htmx:responseError', function (event) {
            if (event.detail.xhr && event.detail.xhr.status === 401) {
                window.location.href = '/login';
            }
        });
    </script>
    <link rel="stylesheet" href="~/styles.css" />
</head>
<body>
    <header>
        <div class="header-inner">
            <div class="header-brand" aria-label="Task board home">
                <span class="header-brand-mark">T</span>
                <span class="header-brand-copy">
                    <strong>Task</strong>
                    <span>Kanban board</span>
                </span>
            </div>

            <nav style="display: flex; align-items: center; gap: 0.75rem;">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span style="opacity: 0.8;">@User.Identity.Name</span>
                    <a class="btn-quiet btn-small" href="/keys">API keys</a>
                    @if (User.IsInRole("task_admin") || User.HasClaim("task_is_admin", "true"))
                    {
                        <a class="btn-quiet btn-small" href="/admin">Admin</a>
                    }
                    <a class="btn-secondary btn-small" href="/api/auth/logout">Sign out</a>
                }
                else
                {
                    <a class="btn-quiet btn-small" href="/login">Sign in</a>
                    <a class="btn-secondary btn-small" href="/signup">Create account</a>
                }
            </nav>

            <button class="btn-secondary theme-toggle" id="theme-toggle" aria-label="Switch to light theme" title="Switch to light theme">
                <span class="theme-toggle-icon" id="theme-toggle-icon">☀</span>
            </button>
        </div>
    </header>

    <main class="main-container">
        @RenderBody()
    </main>

    <footer>
        © @DateTime.Now.Year Task · Focused task management for local teams and agents.
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
